# ORACLE-H Environment Variables
# Copy this file to .env.local and fill in values

# ── Admin Security ────────────────────────────────────────────────────────────
# Secret used to authenticate dashboard → /api/v1/decide calls
# Change this in production!
ORACLE_ADMIN_SECRET=oracle-admin-dev-secret

# ── Webhook Signing ───────────────────────────────────────────────────────────
# HMAC-SHA256 secret for signing webhook payloads sent to agents
# Agents should verify X-Oracle-Signature header against this secret
ORACLE_WEBHOOK_SECRET=oracle-h-dev-secret-change-in-production

# ── Application URL ───────────────────────────────────────────────────────────
# Base URL returned in /validate response as dashboard_url
# Leave as localhost for local development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Optional: Admin Secret for client-side calls ──────────────────────────────
# Only needed if you want to call /api/v1/decide from the browser directly
# In production: use a server-side session instead
NEXT_PUBLIC_ADMIN_SECRET=oracle-admin-dev-secret

# ── Push Notifications (Telegram) ─────────────────────────────────────────────
# Crée un bot en envoyant /newbot à @BotFather sur Telegram (gratuit)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz..."
# Trouve ton ID de chat en parlant à un bot "User Info" (ex: @userinfobot)
TELEGRAM_CHAT_ID="xxxxxxx"
